# Fastmail JMAP App Password (required)
# Create one at: https://app.fastmail.com/settings/security/tokens
FASTMAIL_TOKEN=your-fastmail-app-password

# Folder names (defaults shown; change only if you prefer different names)
AI_TRASH_FOLDER=ai_trash
AI_OUTGOING_FOLDER=ai_outgoing

# PIN expiry in seconds (default: 3600 = 1 hour)
PIN_EXPIRY_SECONDS=3600

# Notification backend: "ntfy" or "telegram"
NOTIFIER=ntfy

# --- ntfy settings (used when NOTIFIER=ntfy) ---
NTFY_TOPIC=my-safemail-topic
NTFY_SERVER=https://ntfy.sh

# --- Telegram settings (used when NOTIFIER=telegram) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
