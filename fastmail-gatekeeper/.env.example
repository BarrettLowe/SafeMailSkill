# ── Fastmail ──────────────────────────────────────────────────────────────────
# Create an App Password at https://app.fastmail.com/settings/security/tokens
# Grant it "Mail" access only.
FASTMAIL_TOKEN=your-fastmail-app-password-here

# ── Mailbox IDs ───────────────────────────────────────────────────────────────
# Run `python scripts/list_mailboxes.py` (with FASTMAIL_TOKEN set) to find IDs.
# Create these two folders in Fastmail first (any name; IDs are what matter).
AI_TRASH_ID=your-ai-trash-mailbox-id
AI_OUTGOING_ID=your-ai-outgoing-mailbox-id

# ── Push notifications (ntfy.sh) ──────────────────────────────────────────────
# Pick a unique, hard-to-guess topic string. No account required.
# Subscribe on your phone at https://ntfy.sh or via the ntfy app.
NTFY_TOPIC=your-unique-topic-string

# ── Gatekeeper security ───────────────────────────────────────────────────────
# A long random secret — only the agent (and you) should know this.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
GATEKEEPER_API_KEY=your-secret-api-key-here
